# Segurança 0B (2026-11-09) — blindagem contra vermes de npm.
# Pacote nenhum roda script na instalação (o sharp do Next usa binário pré-pronto
# em pacote opcional; unrs-resolver/msgpackr-extract também). A Vercel instala por
# `npm ci` (vercel.json).
ignore-scripts=true
# Versão publicada há menos de 7 dias não entra (é onde o verme mora). npm 11+.
min-release-age=7
# Dependência por repositório git não entra.
allow-git=none
